# Supabase (optional). Leave empty to run fully local: no sign-in, no sync, no network calls.
# Copy to .env.local for development; set the same vars in Vercel → Project → Settings → Environment Variables.
# Values: Supabase dashboard → Project Settings → API Keys / Data API. Both are public by design (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
# New projects: the publishable key (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Older projects may use the legacy anon key instead (used only if the publishable key is empty).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mentor shared quota + 7-day request log (optional, SERVER ONLY: never add a NEXT_PUBLIC_ prefix).
# Secret key (sb_secret_...). Legacy projects: SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=
# Token for /ru/admin/mentor (min 24 chars, e.g. `openssl rand -base64 32`). Empty = status page off.
MENTOR_ADMIN_TOKEN=
